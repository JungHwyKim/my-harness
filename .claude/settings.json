{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR}/.claude/harness/hooks/paid_test_check.py\"",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR}/.claude/harness/hooks/heredoc_write_check.py\"",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR}/.claude/harness/hooks/pre_commit_check.py\"",
            "timeout": 900,
            "statusMessage": "커밋 전 Full Quality Gate 실행 중..."
          }
        ]
      },
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR}/.claude/harness/hooks/plan_interview_check.py\"",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR}/.claude/harness/hooks/history_check.py\"",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR}/.claude/harness/hooks/plan_log_check.py\"",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR}/.claude/harness/hooks/plan_interview_check.py\"",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR}/.claude/harness/hooks/history_check.py\"",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR}/.claude/harness/hooks/plan_log_check.py\"",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR}/.claude/harness/hooks/history_check.py\"",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR}/.claude/harness/hooks/task_log_check.py\"",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR}/.claude/harness/hooks/prose_style_check.py\"",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR}/.claude/harness/hooks/plan_log_check.py\"",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR}/.claude/harness/hooks/auto_test_check.py\"",
            "timeout": 120,
            "statusMessage": "Fast Quality Gate 실행 중..."
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR}/.claude/harness/hooks/history_check.py\"",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR}/.claude/harness/hooks/auto_test_check.py\"",
            "timeout": 120,
            "statusMessage": "Fast Quality Gate 실행 중..."
          }
        ]
      },
      {
        "matcher": "ExitPlanMode|AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR}/.claude/harness/hooks/plan_interview_check.py\"",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR}/.claude/harness/hooks/auto_test_check.py\"",
            "timeout": 600,
            "statusMessage": "Full Quality Gate 확인 중..."
          },
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR}/.claude/harness/hooks/history_check.py\"",
            "timeout": 30,
            "statusMessage": "History 중요도 판단 확인 중..."
          },
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR}/.claude/harness/hooks/task_log_check.py\"",
            "timeout": 30,
            "statusMessage": "작업 기록 확인 중..."
          },
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR}/.claude/harness/hooks/plan_log_check.py\"",
            "timeout": 30,
            "statusMessage": "설계 논의 기록 확인 중..."
          }
        ]
      }
    ]
  }
}
