{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/JungHwyKim/my-harness/harness.schema.json",
  "title": "my-harness project configuration",
  "type": "object",
  "required": ["schema_version", "wiki_root", "history", "quality"],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": 2 },
    "wiki_root": { "type": "string", "minLength": 1 },
    "python": { "type": "string", "minLength": 1 },
    "source_prefixes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "harness_paths": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "history": {
      "type": "object",
      "required": ["plan", "task", "verify", "tracked_paths"],
      "properties": {
        "plan": { "type": "string", "minLength": 1 },
        "task": { "type": "string", "minLength": 1 },
        "verify": { "type": "string", "minLength": 1 },
        "tracked_paths": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "quality": {
      "type": "object",
      "required": ["profiles"],
      "properties": {
        "tracked_paths": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "mappings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "tests"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "tests": { "type": "string", "minLength": 1 },
              "why": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "unmapped_by_design": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "profiles": {
          "type": "object",
          "properties": {
            "fast": { "$ref": "#/$defs/profile" },
            "full": { "$ref": "#/$defs/profile" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "checks": {
      "type": "object",
      "properties": {
        "openwork": {
          "type": "object",
          "properties": {
            "sources": {
              "type": "array",
              "items": { "$ref": "#/$defs/openworkSource" }
            },
            "sectionless_by_design": {
              "type": "object",
              "additionalProperties": { "type": "string" }
            }
          },
          "additionalProperties": false
        },
        "expensive_tests": {
          "type": "object",
          "properties": {
            "pytest_markers": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "uniqueItems": true
            },
            "reason": { "type": "string", "minLength": 1 },
            "allow_env": { "type": "string", "pattern": "^[A-Z_][A-Z0-9_]*$" }
          },
          "additionalProperties": false
        },
        "prose_style": { "type": "object" }
      },
      "additionalProperties": true
    }
  },
  "$defs": {
    "profile": {
      "type": "object",
      "required": ["triggers", "stages"],
      "properties": {
        "triggers": {
          "type": "array",
          "items": { "enum": ["post_change", "stop", "pre_commit"] },
          "uniqueItems": true
        },
        "stages": {
          "type": "array",
          "items": { "$ref": "#/$defs/stage" }
        }
      },
      "additionalProperties": false
    },
    "stage": {
      "type": "object",
      "required": ["id", "argv"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" },
        "label": { "type": "string", "minLength": 1 },
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "cwd": { "type": "string", "minLength": 1 },
        "timeout": { "type": "integer", "minimum": 1, "maximum": 3600 },
        "success_codes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "integer" },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "openworkSource": {
      "type": "object",
      "required": ["folder", "heading", "kind", "file_is_feature"],
      "properties": {
        "folder": { "type": "string", "minLength": 1 },
        "heading": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["decision", "followup"] },
        "file_is_feature": { "type": "boolean" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
